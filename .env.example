# ============================================================================
# CustomProxy - environment template
# Copy this file to `.env` and fill in your own values.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# NEVER commit `.env` (it is gitignored).
#
# Nothing here is machine specific: no host paths, no ports that clash with
# another project, no assumption about where you cloned the repo.
# ============================================================================
#
# REQUIRED
# ---------------------------------------------------------------------------
# PROXY_AUTH_TOKEN is the single key your clients use. Generate a long random
# value, e.g.:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
# The proxy refuses to start without it (unless allow_no_auth=true in
# src/config.json, which is only safe on a fully trusted machine).
#
PROXY_AUTH_TOKEN=change-me-to-a-long-random-string


# OPTIONAL - proxy settings
# ---------------------------------------------------------------------------
# Host port the proxy is published on. Bound to 127.0.0.1 only.
PROXY_HOST_PORT=3001
# Internal port; change only if you also change the compose mapping.
PROXY_PORT=3001
# How often each provider's /models list is re-fetched (seconds, min 60).
CATALOG_REFRESH_SECONDS=600


# PROVIDER KEY POOLS
# ---------------------------------------------------------------------------
# Everything below is COMMENTED OUT on purpose. An uncommented placeholder
# would be loaded as if it were a real key and every call would fail upstream.
# Uncomment only the lines you fill in.
#
# KEY FORMAT - one pool per provider, comma-separated. Each item may be:
#
#   key                     -> label is auto-generated (provider-envN)
#   label=key               -> label is the key id you will see in /logs
#
# Example:
#   NVIDIA_API_KEYS=primary=nvapi-AAAA...,backup=nvapi-BBBB...
#
# The `label=` prefix is stripped before the key is sent upstream; it is only
# used for logging (`key` / `api_key_id` in /logs) and rotation stats.
#
# If a key itself contains '=', use the JSON form instead:
#   PROVIDER_API_KEYS_JSON=[{"label":"primary","key":"sk-abc=="}]
# (set "keys_json_env": "PROVIDER_API_KEYS_JSON" on the provider in
# src/config.json)
#
# A provider with no keys configured is skipped: it contributes no models and
# returns 503 no_keys if called directly. You do not need to remove providers
# you do not use - just leave their pool commented out.
#
# Each variable name must match "keys_env" for that provider in
# src/config.json.

# TOKENHARBOUR_API_KEYS=th-1=YOUR_KEY_HERE
# NVIDIA_API_KEYS=nv-1=YOUR_KEY_HERE
# AGNES_API_KEYS=agnes-1=YOUR_KEY_HERE
# GEMINI_API_KEYS=google-1=YOUR_KEY_HERE
# KILO_API_KEYS=kilo-1=YOUR_KEY_HERE
# APINEX_API_KEYS=apx-1=YOUR_KEY_HERE
# MILLIONSEEK_API_KEYS=1mseek-1=YOUR_KEY_HERE
# TEAMOROUTER_API_KEYS=tor-1=YOUR_KEY_HERE
# ZRO_API_KEYS=zro-1=YOUR_KEY_HERE
#
# OpenRouter (free-model catalog). Pool form:
# OPENROUTER_API_KEYS=or-1=YOUR_KEY_HERE
# ...or the JSON form, needed when a key contains '=':
# OPENROUTER_API_KEYS_JSON=[{"label":"or-1","key":"YOUR_KEY_HERE"}]


# ADD A PROVIDER WITHOUT EDITING config.json
# ---------------------------------------------------------------------------
# CUSTOM_PROVIDERS_JSON lets you define providers purely in the environment.
# Each entry is a normal provider block plus a "name".
#
# CUSTOM_PROVIDERS_JSON=[{"name":"myprovider","base_url":"https://api.example.com/v1","keys_env":"MYPROVIDER_API_KEYS","models":[]}]
# MYPROVIDER_API_KEYS=mp-1=YOUR_KEY_HERE
#
# The provider id becomes the model prefix: "myprovider/<upstream-model-id>".


# OPTIONAL - MCP key-rotation relays
# ---------------------------------------------------------------------------
# The proxy works with none of these. Enable only the services you use, then
# point that tool at the relay port instead of the vendor API. Leave
# KEY_ROTATE_SERVICES empty (or unset) to run the proxy alone.
#
# KEY_ROTATE_SERVICES=tavily,firecrawl
#
# TAVILY_API_KEYS=tvly-1=YOUR_KEY_HERE
# TAVILY_PROXY_PORT=4016
#
# FIRECRAWL_API_KEYS=fc-1=YOUR_KEY_HERE
# FIRECRAWL_PROXY_PORT=4017
#
# GEMINI_PROXY_PORT=4019          # pool: GEMINI_API_KEYS (shared with `google`)
# TOKENHARBOUR_PROXY_PORT=4021    # pool: TOKENHARBOUR_API_KEYS (shared)
# CONTEXT7_API_KEYS=ctx7-1=YOUR_KEY_HERE
# CONTEXT7_PROXY_PORT=4022
# ZRO_PROXY_PORT=4030             # pool: ZRO_API_KEYS (shared)
#
# KEY_PROXY_DEBUG=0
