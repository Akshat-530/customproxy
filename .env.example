# ============================================================================
# Model_Providers — environment template
# Copy this file to `.env` and fill in your own values.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# NEVER commit `.env` (it is in .gitignore).
# ============================================================================
#
# KEY FORMAT (CustomProxy + rotation relays read the same pools)
# ---------------------------------------------------------------
# One provider pool per line, comma-separated. Each item may be:
#
#   key                     -> label is auto-generated (provider-envN)
#   label=key               -> label is the key id you will see in /logs
#
# Example:
#   NVIDIA_API_KEYS=primary=nvapi-AAAA...,backup=nvapi-BBBB...
#
# The `label=` prefix is stripped before the key is sent upstream; it is only
# used for logging (`key` / `api_key_id` in /logs) and rotation stats.
#
# If a key itself contains '=', use the JSON form instead:
#   PROVIDER_API_KEYS_JSON=[{"label":"primary","key":"sk-abc=="},{"label":"backup","key":"sk-def=="}]
# (set "keys_json_env": "PROVIDER_API_KEYS_JSON" on the provider in config.json)
#
# Add a new provider: create its pool here, then add the provider block in
# CustomProxy/config.json:
#   "myprovider": {
#     "base_url": "https://api.example.com/v1",
#     "keys_env": "MYPROVIDER_API_KEYS",
#     "models": [],
#     "include_models": [], "exclude_models": [], "max_models": 0,
#     "reasoning_auto": true, "reasoning_default": "medium"
#   }
# The provider id must match the model prefix: "myprovider/<upstream-model-id>".
# ============================================================================


# ----------------------------------------------------------------------------
# CustomProxy (OpenAI-compatible aggregator on :3001)
# ----------------------------------------------------------------------------
PROXY_PORT=3001
PROXY_AUTH_TOKEN=change-me-to-a-long-random-string
CATALOG_REFRESH_SECONDS=600


# ----------------------------------------------------------------------------
# Provider key pools — CustomProxy (model routing + rotation)
# ----------------------------------------------------------------------------
TOKENHARBOUR_API_KEYS=th-1=thk_REPLACE_ME,th-2=thk_REPLACE_ME
NVIDIA_API_KEYS=nv-1=nvapi-REPLACE_ME
AGNES_API_KEYS=agnes-1=sk-REPLACE_ME
GEMINI_API_KEYS=google-1=REPLACE_ME
KILO_API_KEYS=kilo-1=REPLACE_ME
APINEX_API_KEYS=apx-1=sk-REPLACE_ME
MILLIONSEEK_API_KEYS=1mseek-1=hms-REPLACE_ME
TEAMOROUTER_API_KEYS=tor-1=sk-REPLACE_ME
ZRO_API_KEYS=zro-1=sk-REPLACE_ME

# OpenRouter (auto-free catalog). Pool OR JSON form:
OPENROUTER_API_KEYS=or-1=sk-or-REPLACE_ME
# OPENROUTER_API_KEYS_JSON=[{"label":"or-1","key":"sk-or-REPLACE_ME"}]


# ----------------------------------------------------------------------------
# Rotation relays for MCP tools (ports bound inside the container network)
# ----------------------------------------------------------------------------
TAVILY_API_KEYS=tvly-1=tvly-REPLACE_ME
TAVILY_PROXY_PORT=4016

FIRECRAWL_API_KEYS=fc-1=fc-REPLACE_ME
FIRECRAWL_PROXY_PORT=4017

GEMINI_PROXY_PORT=4019          # pool: GEMINI_API_KEYS (shared with `google`)
TOKENHARBOUR_PROXY_PORT=4021    # pool: TOKENHARBOUR_API_KEYS (shared)
CONTEXT7_API_KEYS=ctx7-1=ctx7sk-REPLACE_ME
CONTEXT7_PROXY_PORT=4022
ZRO_PROXY_PORT=4030             # pool: ZRO_API_KEYS (shared)

KEY_ROTATE_SERVICES=tavily,firecrawl,gemini,tokenharbour,context7,zro
KEY_PROXY_DEBUG=0


# ----------------------------------------------------------------------------
# Other
# ----------------------------------------------------------------------------
ENCRYPTION_KEY=change-me
PORT=3000
